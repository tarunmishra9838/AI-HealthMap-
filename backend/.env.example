# AI HealthMap - Backend Environment Variables Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit real passwords or secret keys to GitHub!

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_healthmap
DB_USER=root
DB_PASSWORD=your_database_password_here

# Security / Authentication
# Generate a secure 32+ character random secret for production JWT signing
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Gmail SMTP Configuration (For Forgot Password & OTP Delivery)
# To generate a 16-character App Password:
# Visit https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
